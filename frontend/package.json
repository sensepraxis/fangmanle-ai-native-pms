{
  "name": "fangmanle-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" vite.config.ts index.html",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" vite.config.ts index.html"
  },
  "dependencies": {
    "@wecom/jssdk": "^2.3.3",
    "echarts": "^5.5.1",
    "vue": "^3.5.13",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.4.47",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.6"
  }
}
